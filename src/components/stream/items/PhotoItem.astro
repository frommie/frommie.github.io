---
// src/components/stream/items/PhotoItem.astro
import StreamItem from "../StreamItem.astro";
import {urlFor} from '../../../lib/image'
import { formatExifSummary, effectiveAspectRatio } from '../../../lib/photos';

const { item } = Astro.props;
const exifSummary = formatExifSummary(item.image?.exif);

const widths = [400, 700, 960, 1400];
const src = urlFor(item.image).width(960).auto('format').quality(75).url();
const srcset = widths
  .map(w => `${urlFor(item.image).width(w).auto('format').quality(75).url()} ${w}w`)
  .join(', ');
/* Die Stream-Spalte ist maximal 672px breit (--content-width minus Padding) */
const sizes = '(max-width: 640px) calc(100vw - 48px), 640px';
const ratio = effectiveAspectRatio(item);
const width = 960;
const height = Math.round(width / ratio);
---
<StreamItem type="photo" date={item.publishedAt}>
  <figure>
    <img
      src={src}
      srcset={srcset}
      sizes={sizes}
      width={width}
      height={height}
      alt={item.caption ?? ''}
      loading="lazy"
      decoding="async"
    />
    {item.caption && <figcaption>{item.caption}</figcaption>}
    {exifSummary && <div class="photo-exif">{exifSummary}</div>}
  </figure>
</StreamItem>

<style>
  figure img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-lg);
  }

  figcaption {
    margin-top: var(--sp-3);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-sm);
    color: var(--c-text-tertiary);
    line-height: var(--leading-relaxed);
    padding-left: var(--sp-1);
  }

  figure .photo-exif {
    margin-top: var(--sp-2);
    padding-left: var(--sp-1);
  }
</style>
