---
// src/components/stream/items/PhotoItem.astro
import StreamItem from "../StreamItem.astro";
import {urlFor} from '../../../lib/image'
import { formatExifSummary } from '../../../lib/photos';

const { item } = Astro.props;
const exifSummary = formatExifSummary(item.image?.exif);

const widths = [400, 700, 960, 1400];
const src = urlFor(item.image).width(960).auto('format').quality(80).url();
const srcset = widths
  .map(w => `${urlFor(item.image).width(w).auto('format').quality(80).url()} ${w}w`)
  .join(', ');
const sizes = '(max-width: 640px) 100vw, min(900px, calc(100vw - 3rem))';
---
<StreamItem type="photo" date={item.publishedAt}>
  <figure>
    <img src={src} srcset={srcset} sizes={sizes} alt={item.caption ?? ''} />
    {item.caption && <figcaption>{item.caption}</figcaption>}
    {exifSummary && <div class="photo-exif">{exifSummary}</div>}
  </figure>
</StreamItem>

<style>
  figure img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-lg);
  }

  figcaption {
    margin-top: var(--sp-3);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-sm);
    color: var(--c-text-tertiary);
    line-height: var(--leading-relaxed);
    padding-left: var(--sp-1);
  }

  figure .photo-exif {
    margin-top: var(--sp-2);
    padding-left: var(--sp-1);
  }
</style>
