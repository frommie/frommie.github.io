---
// src/components/stream/StreamItem.astro
// `href` (optional) macht das Datum zum Permalink des Beitrags.
const { type, date, href } = Astro.props;

const TYPE_LABEL: Record<string, string> = {
  article: 'Artikel',
  micro:   'Micro',
  photo:   'Foto',
};

function fmtDate(iso?: string): string {
  if (!iso) return '';
  return new Date(iso).toLocaleDateString('de-DE', {
    day: 'numeric', month: 'short', year: 'numeric',
  });
}
---

<article class={`stream-item stream-item--${type}`} data-type={type}>
  <div class="stream-meta">
    <span class="stream-type">{TYPE_LABEL[type] ?? type}</span>
    <span class="stream-dot"></span>
    {href ? (
      <a class="stream-date-link" href={href} title="Permalink zu diesem Beitrag">
        <time class="stream-date" datetime={date}>{fmtDate(date)}</time>
      </a>
    ) : (
      <time class="stream-date" datetime={date}>{fmtDate(date)}</time>
    )}
  </div>

  <slot />
</article>