---
// src/components/LinkPreviewCard.astro
import type { LinkPreview } from '../lib/micro';

interface Props {
  url:     string;
  preview: LinkPreview | null;
}

const { url, preview } = Astro.props;
const domain = preview?.domain ?? new URL(url).hostname.replace(/^www\./, '');
const title  = preview?.title ?? domain;
---

<a
  class="link-preview"
  href={preview?.url ?? url}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Link öffnen: ${title}`}
>
  {preview?.image && (
    <span class="link-preview-thumb">
      <img src={preview.image} alt="" loading="lazy" />
    </span>
  )}
  <span class="link-preview-text">
    <span class="link-preview-title" title={title}>{title}</span>
    {preview?.description && (
      <span class="link-preview-desc" title={preview.description}>{preview.description}</span>
    )}
  </span>
  <span class="link-preview-domain">
    {domain}
    <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2.5" aria-hidden="true">
      <path d="M7 17 17 7M7 7h10v10" />
    </svg>
  </span>
</a>

<style>
  .link-preview {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    width: 100%;
    box-sizing: border-box;
    padding: var(--sp-2) var(--sp-3);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    background: var(--c-surface);
    text-decoration: none;
    transition: border-color var(--t-fast), background var(--t-fast);
  }
  .link-preview:hover {
    border-color: var(--c-border-strong);
    background: var(--c-surface-2);
  }

  .link-preview-thumb {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--c-surface-2);
  }
  .link-preview-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .link-preview-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1px;
  }

  .link-preview-title {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--c-text);
    line-height: var(--leading-snug);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .link-preview-desc {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--c-text-secondary);
    line-height: var(--leading-snug);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .link-preview-domain {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--c-text-tertiary);
    white-space: nowrap;
  }
</style>
