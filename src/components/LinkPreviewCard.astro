---
// src/components/LinkPreviewCard.astro
import type { LinkPreview } from '../lib/micro';

interface Props {
  url:     string;
  preview: LinkPreview | null;
}

const { url, preview } = Astro.props;
const domain = preview?.domain ?? new URL(url).hostname.replace(/^www\./, '');
const title  = preview?.title ?? domain;
---

<a
  class="link-preview"
  class:list={{ 'link-preview--with-image': !!preview?.image }}
  href={preview?.url ?? url}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Link öffnen: ${title}`}
>
  {preview?.image && (
    <span class="link-preview-thumb">
      <img src={preview.image} alt="" loading="lazy" />
    </span>
  )}
  <span class="link-preview-body">
    <span class="link-preview-title">{title}</span>
    {preview?.description && (
      <span class="link-preview-desc">{preview.description}</span>
    )}
    <span class="link-preview-domain">
      {domain}
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path d="M7 17 17 7M7 7h10v10" />
      </svg>
    </span>
  </span>
</a>

<style>
  .link-preview {
    display: flex;
    align-items: stretch;
    gap: var(--sp-3);
    max-width: 480px;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    background: var(--c-surface);
    text-decoration: none;
    overflow: hidden;
    transition: border-color var(--t-fast), background var(--t-fast);
  }
  .link-preview:hover {
    border-color: var(--c-border-strong);
    background: var(--c-surface-2);
  }

  .link-preview-thumb {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    background: var(--c-surface-2);
  }
  .link-preview-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .link-preview-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    min-width: 0;
    padding: var(--sp-3) var(--sp-4);
  }
  .link-preview--with-image .link-preview-body {
    padding-left: 0;
  }

  .link-preview-title {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--c-text);
    line-height: var(--leading-snug);
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .link-preview-desc {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--c-text-secondary);
    line-height: var(--leading-snug);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .link-preview-domain {
    display: flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--c-text-tertiary);
    margin-top: 2px;
  }
</style>
