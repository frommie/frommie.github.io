---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LinkPreviewCard from "../../components/LinkPreviewCard.astro";
import {
  fetchMicros,
  fetchLinkPreview,
  processBody,
  microSlug,
} from "../../lib/micro";

export async function getStaticPaths() {
  const posts = await fetchMicros();
  const seen = new Set<string>();

  return posts
    .filter(post => post.publishedAt)
    .map(post => {
      const slug = microSlug(post);
      if (seen.has(slug)) {
        throw new Error(
          `Doppelter Micro-Slug "${slug}" — zwei Posts haben ein publishedAt in derselben Minute. ` +
          `Bitte publishedAt eines Posts um mindestens eine Minute verschieben.`,
        );
      }
      seen.add(slug);
      return { params: { slug }, props: { post } };
    });
}

const { post } = Astro.props;
const preview = post.link ? await fetchLinkPreview(post.link) : null;

function fmtDateTime(iso?: string): string {
  if (!iso) return '';
  const d = new Date(iso);
  const date = d.toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' });
  const time = d.toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' });
  return `${date}, ${time} Uhr`;
}

const dateLabel = post.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })
  : '';
const title = `Micro vom ${dateLabel}`;
const excerpt = (post.text ?? '').replace(/\s+/g, ' ').trim().slice(0, 200);
---

<BaseLayout title={title} description={excerpt} ogType="article">
  <div class="micro-wrap">

    <a href="/micros/" class="back-link">← Micros</a>

    <article class="micro-single">
      <div class="micro-single-meta">
        <span class="meta-type">Micro</span>
        <span class="meta-dot"></span>
        <time class="meta-item" datetime={post.publishedAt}>
          {fmtDateTime(post.publishedAt)}
        </time>
      </div>

      <div class="micro-single-body" set:html={processBody(post.text ?? '')} />

      {post.link && (
        <LinkPreviewCard url={post.link} preview={preview} />
      )}
    </article>

  </div>
</BaseLayout>

<style>
  .micro-wrap {
    max-width: var(--article-width);
    margin: 0 auto;
    padding: var(--sp-16) var(--sp-6) var(--sp-24);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--c-text-secondary);
    text-decoration: none;
    margin-bottom: var(--sp-10);
    transition: color var(--t-fast);
  }
  .back-link:hover { color: var(--c-text); }

  .micro-single-meta {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    flex-wrap: wrap;
    margin-bottom: var(--sp-5);
  }
  .meta-type {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--c-text-tertiary);
  }
  .meta-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--c-border-strong);
    flex-shrink: 0;
  }
  .meta-item {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--c-text-tertiary);
    letter-spacing: 0.03em;
  }

  /* set:html content — :global needed for injected markup */
  .micro-single-body :global(p) {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--c-text);
    margin-bottom: var(--sp-3);
  }
  .micro-single-body :global(p:last-child) { margin-bottom: 0; }
  .micro-single-body :global(a) {
    color: var(--c-accent);
    text-decoration: underline;
    text-decoration-color: var(--c-accent-subtle);
    text-underline-offset: 3px;
    word-break: break-all;
    transition: text-decoration-color var(--t-fast);
  }
  .micro-single-body :global(a:hover) {
    text-decoration-color: var(--c-accent);
  }

  .micro-single > :global(.link-preview) {
    margin-top: var(--sp-5);
  }

  @media (max-width: 560px) {
    .micro-wrap { padding: var(--sp-8) var(--sp-4) var(--sp-16); }
  }
</style>
