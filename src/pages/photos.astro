---
import BaseLayout from "../layouts/BaseLayout.astro";
import PhotoGrid   from '../components/PhotoGrid.astro';
---

<BaseLayout title="Fotos" description="Fotografie von Christian Frommert.">
  <main class="container">
    <div style="padding: var(--sp-12) 0 var(--sp-24)">
      <header style="margin-bottom: var(--sp-8)">
        <h1 style="font-size: var(--text-2xl); font-weight: 600;
                   letter-spacing: -0.025em; margin-bottom: var(--sp-3)">
          Fotos
        </h1>
        <p style="color: var(--c-text-secondary); font-size: var(--text-base)">
          Direkt aus der Kamera – hauptsächlich mit einer Fujifilm X100VI.
        </p>
      </header>
      <PhotoGrid />
    </div>
  </main>
</BaseLayout>