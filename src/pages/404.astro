---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="Diese Seite gibt es nicht — oder nicht mehr.">
  <div class="container">
    <div class="nf-page">
      <p class="nf-code">404 · not found</p>
      <h1 class="page-title">Hier ist nichts.</h1>
      <p class="nf-body">
        Diese Seite gibt es nicht — oder nicht mehr. Vielleicht war der Link alt,
        vielleicht habe ich beim Umbauen etwas verschoben. Passiert.
      </p>
      <div class="nf-links">
        <a class="btn btn-primary" href="/">Zum Stream</a>
        <a class="btn btn-ghost" href="/photos/">Oder erstmal Fotos schauen →</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .nf-page {
    padding: var(--sp-20) 0 var(--sp-24);
    max-width: 560px;
  }

  .nf-code {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-text-tertiary);
    margin-bottom: var(--sp-4);
  }

  .nf-body {
    font-size: var(--text-base);
    color: var(--c-text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--sp-8);
  }

  .nf-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    align-items: center;
  }
</style>
