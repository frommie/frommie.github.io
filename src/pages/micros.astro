---
import BaseLayout from '../layouts/BaseLayout.astro';
import MicroFeed from '../components/MicroFeed.astro';
---

<BaseLayout title="Micros" description="Kurze Gedanken und Notizen von Christian Frommert.">
  <div class="container">
    <div style="padding: var(--sp-12) 0 var(--sp-24)">
      <header style="margin-bottom: var(--sp-8)">
        <h1 style="font-size: var(--text-2xl); font-weight: 600;
                   letter-spacing: -0.025em; margin-bottom: var(--sp-3)">
          Micros
        </h1>
        <p style="color: var(--c-text-secondary); font-size: var(--text-base)">
          Kurze Gedanken, Notizen und Beobachtungen.
        </p>
      </header>

      <MicroFeed />
    </div>
  </div>
</BaseLayout>