---
// src/pages/index.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import Stream from "../components/stream/Stream.astro";
import { getStream } from "../lib/api";

import { Image } from "astro:assets";
import profileImage from "../assets/profile.jpg";

const items = await getStream();
---

<BaseLayout title="Home">
  <div class="container">
    <!-- HERO -->
    <header class="hero">
      <div class="hero-layout">
 
        <!-- LEFT: text -->
        <div class="hero-body">
          <!--<div class="hero-status">
            <span class="hero-status-dot"></span>
            Available for work
          </div>-->
          <h1 class="hero-name">Hallo, ich bin Christian.</h1>
          <p class="hero-bio">
            Tagsüber SAP-EAM-Berater bei BEW Berliner Energie &amp; Wärme, abends
            baue ich Web-Apps — und wenn ich nicht am Rechner sitze, fotografiere
            ich. Hier landet alles davon: Fotos, kurze Gedanken, ab und zu ein Artikel.
          </p>
          <div class="hero-links">
            <a class="btn btn-primary" href="/about/">Über mich</a>
            <a href="mailto:christian.frommert@gmail.com" class="btn btn-secondary">Schreib mir</a>
            <a class="btn btn-ghost" href="/now/">Was ich gerade mache →</a>
          </div>
        </div>
 
        <!-- RIGHT: profile photo -->
        <div class="hero-photo-wrap">
          <div class="hero-photo">
            <Image
              src={profileImage}
              alt="Christian Frommert"
              width={528}
              height={528}
            />
          </div>
        </div>
      </div>
    </header>
    <Stream items={items} />
  </div>
</BaseLayout>