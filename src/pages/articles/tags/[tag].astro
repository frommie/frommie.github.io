---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  fetchArticles,
  fetchArticlesByTag,
  timeBucket,
  fmtDate,
  fmtShortDate,
} from "../../../lib/articles";

export async function getStaticPaths() {
  const articles = await fetchArticles();
  const tags = [...new Set(articles.flatMap(a => a.tags ?? []))];
  return tags.map(tag => ({ params: { tag } }));
}

const { tag } = Astro.params;
const articles = await fetchArticlesByTag(tag);
---

<BaseLayout title={`#${tag} — Articles`}>
  <div class="container">
    <div class="tag-page">

      <a href="/articles/" class="back-link">← Artikel</a>

      <header class="tag-header">
        <div class="tag-eyebrow">Tag</div>
        <h1 class="tag-title">#{tag}</h1>
        <p class="tag-count">
          {articles.length} Artikel
        </p>
      </header>

      <div class="article-list">
        {articles.map(article => {
          const tags   = article.tags ?? [];
          const bucket = timeBucket(article.readingTime);
          return (
            <article class="article-item">
              <div class="item-top">
                <a class="article-title" href={`/articles/${article.slug}`}>
                  {article.title}
                </a>
                <span class={`rt-badge rt-${bucket}`}>
                  {article.readingTime} min
                </span>
              </div>
              <div class="item-meta">
                <time class="article-date" datetime={article.publishedAt ?? ''}>
                  {fmtShortDate(article.publishedAt)}
                </time>
                {tags.filter(t => t !== tag).length > 0 && (
                  <div class="article-tags">
                    {tags.filter(t => t !== tag).map(t => (
                      <a class="article-tag" href={`/articles/tags/${t}`}>#{t}</a>
                    ))}
                  </div>
                )}
              </div>
              {article.excerpt && (
                <p class="article-excerpt">{article.excerpt}</p>
              )}
              <a class="item-readmore" href={`/articles/${article.slug}`}>
                Artikel lesen →
              </a>
            </article>
          );
        })}
      </div>

    </div>
  </div>
</BaseLayout>

<style>
  .tag-page {
    padding: var(--sp-12) 0 var(--sp-24);
  }

  /* ── Back link ──────────────────────────────────────────────── */
  .back-link {
    display: inline-flex;
    align-items: center;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--c-text-secondary);
    text-decoration: none;
    margin-bottom: var(--sp-10);
    transition: color var(--t-fast);
  }
  .back-link:hover { color: var(--c-text); }

  /* ── Header ─────────────────────────────────────────────────── */
  .tag-header { margin-bottom: var(--sp-10); }

  .tag-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-text-tertiary);
    margin-bottom: var(--sp-3);
  }

  .tag-title {
    font-size: var(--text-3xl);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: var(--leading-tight);
    color: var(--c-text);
    margin-bottom: var(--sp-3);
  }

  .tag-count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--c-text-tertiary);
    letter-spacing: 0.03em;
  }

  /* ── Article list ────────────────────────────────────────────── */
  .article-item {
    padding: var(--sp-5) 0;
    border-bottom: 1px solid var(--c-border);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }
  .article-list .article-item:last-child { border-bottom: none; }

  .item-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
  }

  .article-title {
    font-size: var(--text-base);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: var(--leading-snug);
    color: var(--c-text);
    text-decoration: none;
    flex: 1;
    transition: color var(--t-fast);
  }
  .article-title:hover { color: var(--c-accent); }

  .rt-badge {
    font-size: 10px;
    font-family: var(--font-mono);
    padding: 2px var(--sp-2);
    border-radius: var(--radius-sm);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .rt-quick  { background: #eaf3de; color: #3b6d11; }
  .rt-medium { background: var(--c-accent-subtle); color: var(--c-accent-text); }
  .rt-long   { background: #eeedfe; color: #3c3489; }
  [data-theme="dark"] .rt-quick  { background: #172b0b; color: #86c04e; }
  [data-theme="dark"] .rt-long   { background: #1e1a3d; color: #a89ff4; }

  .item-meta {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }

  .article-date {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--c-text-tertiary);
  }

  .article-tags { display: flex; gap: var(--sp-2); flex-wrap: wrap; }

  .article-tag {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--c-text-tertiary);
    text-decoration: none;
    transition: color var(--t-fast);
  }
  .article-tag:hover { color: var(--c-accent); }

  .article-excerpt {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--c-text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .item-readmore {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--c-accent);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    transition: gap var(--t-fast);
  }
  .item-readmore:hover { gap: var(--sp-2); }
</style>
