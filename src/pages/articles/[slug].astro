---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PortableText } from "astro-portabletext";
import { getArticle, getAllSlugs } from "../../lib/api";

export async function getStaticPaths() {
  const slugs = await getAllSlugs();
  return slugs.map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;
const article = await getArticle(slug);

function fmtDate(iso?: string) {
  if (!iso) return '';
  return new Date(iso).toLocaleDateString('de-DE', {
    month: 'long', day: 'numeric', year: 'numeric',
  });
}
---

<BaseLayout title={article.title} description={article.excerpt} ogType="article">
  <div class="article-wrap">

    <a href="/articles/" class="back-link">← Artikel</a>

    <header class="article-header">
      <div class="article-meta">
        <time class="meta-item" datetime={article.publishedAt}>
          {fmtDate(article.publishedAt)}
        </time>
        {article.readingTime && (
          <>
            <span class="meta-dot"></span>
            <span class="meta-item">{article.readingTime} Min. Lesezeit</span>
          </>
        )}
        {(article.tags ?? []).length > 0 && (
          <>
            <span class="meta-dot"></span>
            <div class="meta-tags">
              {(article.tags ?? []).map((tag: string) => (
                <span class="meta-tag">#{tag}</span>
              ))}
            </div>
          </>
        )}
      </div>

      <h1 class="article-title">{article.title}</h1>

      {article.excerpt && (
        <p class="article-lede">{article.excerpt}</p>
      )}
    </header>

    <div class="article-divider"></div>

    {article.content && (
      <div class="article-body">
        <PortableText value={article.content} />
      </div>
    )}

    <div class="article-footer">
      <a href="/articles/" class="back-link">← Zurück zu Artikeln</a>
    </div>

  </div>
</BaseLayout>

<style>
  .article-wrap {
    max-width: var(--article-width);
    margin: 0 auto;
    padding: var(--sp-16) var(--sp-6) var(--sp-24);
  }

  /* ── Back link ──────────────────────────────────────────────── */
  .back-link {
    display: inline-flex;
    align-items: center;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--c-text-secondary);
    text-decoration: none;
    margin-bottom: var(--sp-10);
    transition: color var(--t-fast);
  }
  .back-link:hover { color: var(--c-text); }

  /* ── Header ─────────────────────────────────────────────────── */
  .article-header { margin-bottom: var(--sp-8); }

  .article-meta {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    flex-wrap: wrap;
    margin-bottom: var(--sp-5);
  }
  .meta-item {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--c-text-tertiary);
    letter-spacing: 0.03em;
  }
  .meta-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--c-border-strong);
    flex-shrink: 0;
  }
  .meta-tags {
    display: flex;
    gap: var(--sp-2);
  }
  .meta-tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--c-text-tertiary);
    letter-spacing: 0.03em;
  }

  .article-title {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: var(--leading-tight);
    color: var(--c-text);
    margin-bottom: var(--sp-5);
  }

  .article-lede {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--c-text-secondary);
    max-width: 56ch;
  }

  /* ── Divider ────────────────────────────────────────────────── */
  .article-divider {
    height: 1px;
    background: var(--c-border);
    margin-bottom: var(--sp-10);
  }

  /* ── Body prose ─────────────────────────────────────────────── */
  .article-body {
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.8;
    color: var(--c-text);
  }

  .article-body :global(p) {
    margin-bottom: 1.6em;
  }

  .article-body :global(h2) {
    font-family: var(--font-sans);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: var(--leading-snug);
    color: var(--c-text);
    margin-top: 2.5em;
    margin-bottom: 0.75em;
  }

  .article-body :global(h3) {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: var(--leading-snug);
    color: var(--c-text);
    margin-top: 2em;
    margin-bottom: 0.5em;
  }

  .article-body :global(a) {
    color: var(--c-accent);
    text-decoration: underline;
    text-decoration-color: var(--c-accent-subtle);
    text-underline-offset: 3px;
    transition: color var(--t-fast), text-decoration-color var(--t-fast);
  }
  .article-body :global(a:hover) {
    color: var(--c-accent-hover);
    text-decoration-color: var(--c-accent);
  }

  .article-body :global(strong) {
    font-weight: 600;
    color: var(--c-text);
  }

  .article-body :global(em) {
    font-style: italic;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    padding-left: 1.5em;
    margin-bottom: 1.6em;
  }
  .article-body :global(li) {
    margin-bottom: 0.4em;
  }

  .article-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--c-code-bg);
    color: var(--c-code-text);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--c-border);
  }

  .article-body :global(pre) {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    padding: var(--sp-5);
    overflow-x: auto;
    margin-bottom: 1.6em;
  }
  .article-body :global(pre code) {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.7;
    background: none;
    color: var(--c-text);
    padding: 0;
    border: none;
    border-radius: 0;
  }

  .article-body :global(blockquote) {
    border-left: 2px solid var(--c-accent);
    padding-left: var(--sp-5);
    margin-left: 0;
    margin-bottom: 1.6em;
    color: var(--c-text-secondary);
    font-style: italic;
  }

  .article-body :global(hr) {
    border: none;
    border-top: 1px solid var(--c-border);
    margin: 2.5em 0;
  }

  /* ── Footer ─────────────────────────────────────────────────── */
  .article-footer {
    margin-top: var(--sp-16);
    padding-top: var(--sp-8);
    border-top: 1px solid var(--c-border);
  }

  /* ── Responsive ─────────────────────────────────────────────── */
  @media (max-width: 560px) {
    .article-wrap { padding: var(--sp-8) var(--sp-4) var(--sp-16); }
  }
</style>
